{
  "entities": {
    "property": {
      "title": "Imóvel",
      "description": "Dados principais de um imóvel da imobiliária",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "city": { "type": "string" },
        "neighborhood": { "type": "string" },
        "condominium": { "type": "string" },
        "purpose": { "type": "string", "enum": ["Venda", "Locação"] },
        "price": { "type": "string" },
        "priceValue": { "type": "number" },
        "category": { "type": "string", "enum": ["Residencial", "Comercial", "Rural"] },
        "type": { "type": "string" },
        "beds": { "type": "number" },
        "suites": { "type": "number" },
        "baths": { "type": "number" },
        "parkingCovered": { "type": "number" },
        "parkingUncovered": { "type": "number" },
        "area": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price", "image"]
    },
    "visit": {
      "title": "Visita",
      "description": "Agendamento de visita a um imóvel",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "propertyName": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] }
      },
      "required": ["propertyId", "name", "phone", "date", "time"]
    },
    "blocked_slot": {
      "title": "Horário Bloqueado",
      "description": "Horário que não pode ser agendado",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "time": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["date", "time"]
    },
    "corretor": {
      "title": "Corretor",
      "description": "Dados cadastrais do corretor de imóveis",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "creci": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "ativo": { "type": "boolean" }
      },
      "required": ["nome"]
    },
    "proprietario": {
      "title": "Proprietário",
      "description": "Dados civis e faturamento do proprietário",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "endereco": { "type": "string" },
        "ativo": { "type": "boolean" }
      },
      "required": ["nome"]
    },
    "site_settings": {
      "title": "Configurações do Site",
      "description": "Identidade e contatos globais da imobiliária",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "creci": { "type": "string" },
        "address": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "usuario": {
      "title": "Usuário",
      "description": "Dados do usuário com perfil de acesso e permissões",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "cargo": { "type": "string" },
        "creci": { "type": "string" },
        "perfil": { "type": "string", "enum": ["Administrador", "Líder", "Corretor", "Assistente", "Financeiro", "Marketing", "Proprietário"] },
        "status": { "type": "string", "enum": ["Ativo", "Inativo", "Bloqueado", "Férias"] },
        "permissoes": { "type": "array" },
        "equipe": { "type": "string" },
        "supervisor": { "type": "string" },
        "foto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "nome", "perfil", "status"]
    },
    "notificacao": {
      "title": "Notificação",
      "description": "Notificação de fluxo de aprovação ou sistema",
      "type": "object",
      "properties": {
        "tipo": { "type": "string" },
        "destinatarioEmail": { "type": "string" },
        "destinatarioPerfil": { "type": "string" },
        "mensagem": { "type": "string" },
        "imovelId": { "type": "string" },
        "imovelTitulo": { "type": "string" },
        "lido": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mensagem", "lido"]
    }
  },
  "firestore": {
    "/usuarios/{usuarioId}": {
      "schema": "usuario",
      "description": "Coleção de perfis de usuário do sistema"
    },
    "/notificacoes/{notificacaoId}": {
      "schema": "notificacao",
      "description": "Mensagens de notificação do sistema"
    },
    "/imoveis/{imovelId}": {
      "schema": "property",
      "description": "Catálogo de imóveis aprovados (imoveis)"
    },
    "/property_submissions/{submissionId}": {
      "schema": "property",
      "description": "Submissões enviadas por proprietários"
    },
    "/visits/{visitId}": {
      "schema": "visit",
      "description": "Agendamentos de visitas"
    },
    "/blocked_slots/{slotId}": {
      "schema": "blocked_slot",
      "description": "Bloqueios de agenda"
    },
    "/favorites/{userId}/items/{propertyId}": {
      "schema": {
        "title": "Favorito",
        "type": "object",
        "properties": {
          "addedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Imóveis favoritados pelo usuário"
    },
    "/leads/{leadId}": {
      "schema": {
        "title": "Lead",
        "description": "Contato de interessado",
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "interest": { "type": "string" }
        }
      },
      "description": "Contatos captados pelo site"
    },
    "/tiposImovel/{id}": {
      "schema": "object",
      "description": "Opções de tipos de imóvel"
    },
    "/tiposNegocio/{id}": {
      "schema": "object",
      "description": "Opções de tipos de negócio"
    },
    "/statusImovel/{id}": {
      "schema": "object",
      "description": "Opções de status do imóvel"
    },
    "/cidades/{id}": {
      "schema": "object",
      "description": "Opções de cidades disponíveis"
    },
    "/bairros/{id}": {
      "schema": "object",
      "description": "Opções de bairros mapeados"
    },
    "/caracteristicas/{id}": {
      "schema": "object",
      "description": "Opções de características gerais"
    },
    "/ambientes/{id}": {
      "schema": "object",
      "description": "Opções de ambientes"
    },
    "/caracteristicasEmpreendimento/{id}": {
      "schema": "object",
      "description": "Opções de características do empreendimento"
    },
    "/lazer/{id}": {
      "schema": "object",
      "description": "Opções de itens de lazer"
    },
    "/instalacoes/{id}": {
      "schema": "object",
      "description": "Opções de instalações"
    },
    "/acabamentos/{id}": {
      "schema": "object",
      "description": "Opções de acabamentos"
    },
    "/proximidades/{id}": {
      "schema": "object",
      "description": "Opções de proximidades"
    },
    "/faixasPreco/{id}": {
      "schema": "object",
      "description": "Opções de faixas de preço"
    },
    "/caracteristicasApartamento/{id}": {
      "schema": "object",
      "description": "Opções de características de apartamento"
    },
    "/corretores/{id}": {
      "schema": "corretor",
      "description": "Equipe de corretores"
    },
    "/proprietarios/{id}": {
      "schema": "proprietario",
      "description": "Cadastro de proprietários"
    },
    "/siteSettings/{id}": {
      "schema": "site_settings",
      "description": "Configurações gerais do site"
    }
  }
}
